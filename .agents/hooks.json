{
  "wake-autosave": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/USER/Desktop/Sentinel/wake.exe checkpoint --objective \"Antigravity Auto-Save\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "wake-resume-check": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "C:/Users/USER/Desktop/Sentinel/wake.exe resume > .agents/last_resume.txt; echo \"{}\""
      }
    ]
  }
}
